# Desi Jobs - Backend Environment Variables
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
BRAND_COLOR=#17324D

# Frontend & Admin URLs for CORS
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=desijobs_db

# Security & JWT Secret
SECRET_KEY=generate_a_secure_jwt_secret_key_here_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Super Admin Credentials
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=admin@desijobs.com
SUPER_ADMIN_DEFAULT_PASSWORD=Admin@DesiJobs2026!

# Firebase Authentication (Paste JSON or path to serviceAccountKey.json)
FIREBASE_PROJECT_ID=desi-jobs-portal
FIREBASE_SERVICE_ACCOUNT_JSON=

# xAI Grok Vision API (for Photo Resume Extraction)
XAI_API_KEY=xai-your-api-key-here
XAI_MODEL=grok-2-vision-1212

# File Upload Settings
MAX_UPLOAD_SIZE_MB=15
