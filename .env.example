# ========================================================
# Desi Jobs - Backend Environment Variables
# ========================================================
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
BRAND_COLOR=#17324D

# Frontend & Admin URLs for CORS (adjust for production)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.iudwknk.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=desijobs_prod

# Security & JWT Secret
SECRET_KEY=desi-jobs-production-secret-jwt-auth-key-2026-very-secure
# Token expiration set to 1 Year (365 days * 24 hours * 60 minutes = 525600)
ACCESS_TOKEN_EXPIRE_MINUTES=525600

# Super Admin Credentials
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL=admin@desijobs.com
SUPER_ADMIN_DEFAULT_PASSWORD=Admin@DesiJobs2026!

# Cloudinary (Media & Image Upload CDN)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Groq Cloud AI (High-speed LPU Vision & LLM for Resume Parsing)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# xAI Grok API (Optional)
XAI_API_KEY=
XAI_MODEL=grok-2-vision-1212

# Firebase Authentication (Optional - for Google Sign-In)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# File Upload Settings
MAX_UPLOAD_SIZE_MB=15
